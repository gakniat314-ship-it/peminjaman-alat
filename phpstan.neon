includes:
    # Memuat ekstensi analisis untuk Laravel dan tipe tanggal Carbon.
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    # Membatasi analisis statis pada source aplikasi dan konfigurasi runtime.
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Mengatur tingkat ketat pemeriksaan PHPStan untuk kode proyek.
    level: 7
